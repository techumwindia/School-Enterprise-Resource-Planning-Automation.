# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=erp.yourschool.in,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.yourschool.in

# School details printed on receipts, payslips and report cards
SCHOOL_NAME=Your School Name
SCHOOL_ADDRESS=Street, Town, District - PIN
SCHOOL_PHONE=+91 00000 00000
SCHOOL_EMAIL=office@yourschool.in

# Database: leave DB_ENGINE=sqlite for local testing, use mysql on the server
DB_ENGINE=mysql
DB_NAME=school_erp
DB_USER=school_erp
DB_PASSWORD=strong-password
DB_HOST=127.0.0.1
DB_PORT=3306
